{
  "info": {
    "_postman_id": "f1e4dfc2-2f6a-4fe5-8b2c-9b2d8b5b4c21",
    "name": "Foods API Contract",
    "description": "Collection for testing the Foods API with API key protection, CRUD, and per-food apiKey retrieval.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Foods CRUD",
      "item": [
        {
          "name": "GET /api/foods - list foods",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/foods"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is JSON', function () {",
                  "  pm.response.to.be.json;",
                  "});",
                  "pm.test('Has data array', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('data');",
                  "  pm.expect(body.data).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /api/foods without API key - unauthorized",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/foods"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "pm.test('Unauthorized payload', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('error');",
                  "  pm.expect(body.error).to.eql('Invalid API key');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /api/foods - create food",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}", "type": "text" },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Banane\",\n  \"category\": \"fruit\",\n  \"description\": \"Fruit test\",\n  \"calories\": 95,\n  \"tags\": [\"snack\", \"tropical\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/foods"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Returns created item and apiKey', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('data');",
                  "  pm.expect(body).to.have.property('apiKey');",
                  "  pm.expect(body.data).to.have.property('id');",
                  "  pm.expect(body.apiKey).to.be.a('string');",
                  "  pm.environment.set('foodId', body.data.id);",
                  "  pm.environment.set('foodApiKey', body.apiKey);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /api/foods - invalid body",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}", "type": "text" },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"fruit\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/foods"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Validation error payload', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('error');",
                  "  pm.expect(body.error).to.eql('Validation error');",
                  "  pm.expect(body).to.have.property('details');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "PUT /api/foods/:id - update food",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}", "type": "text" },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Banane mise à jour\",\n  \"category\": \"fruit\",\n  \"description\": \"Version modifiée\",\n  \"calories\": 100,\n  \"tags\": [\"updated\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/foods/{{foodId}}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Updated food returned', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('data');",
                  "  pm.expect(body.data).to.have.property('id');",
                  "  pm.expect(body.data.id).to.eql(pm.environment.get('foodId'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /api/foods/:id/api-key - get food api key",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/foods/{{foodId}}/api-key"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns apiKey for food', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('apiKey');",
                  "  pm.expect(body.id).to.eql(pm.environment.get('foodId'));",
                  "  pm.environment.set('foodApiKey', body.apiKey);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "DELETE /api/foods/:id - delete food",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/foods/{{foodId}}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Deleted message', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('message');",
                  "  pm.expect(body.message).to.eql('Deleted');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "DELETE /api/foods/:id - not found",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/foods/non-existent-id"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404', function () {",
                  "  pm.response.to.have.status(404);",
                  "});",
                  "pm.test('Not found payload', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('error');",
                  "  pm.expect(body.error).to.eql('Not found');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "apiKey",
      "value": "change_me_to_a_secret_value"
    },
    {
      "key": "foodId",
      "value": ""
    },
    {
      "key": "foodApiKey",
      "value": ""
    }
  ]
}
