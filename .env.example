# Modèle. Copier en .env, qui n'est pas suivi par Git, et y mettre ses propres
# valeurs. Aucune valeur réelle ne doit apparaître ici : ce fichier est publié.

# La clé attendue dans l'en-tête x-api-key des routes /api/foods.
API_KEY=une-cle-a-vous-longue-et-aleatoire

# Base PostgreSQL. En local, la base de docker-compose.yml suffit :
DATABASE_URL="postgresql://postgres:motdepasse-local@localhost:5434/foods"
DIRECT_URL="postgresql://postgres:motdepasse-local@localhost:5434/foods"

# En ligne, chez Neon ou Supabase, deux adresses sont données : celle qui passe
# par le regroupeur de connexions pour l'application (DATABASE_URL), et la
# connexion directe pour les migrations (DIRECT_URL).

# Facultatif : l'assistant de recettes (POST /api/foods/suggestion). Sans elle, il répond 503.
MISTRAL_API_KEY=""
